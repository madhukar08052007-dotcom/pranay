# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=agrimind_super_secret_jwt_key_2026_production_ready_99218

# Database Configuration (PostgreSQL connection URL or parameters)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrimind_db
# Alternative PG params if DATABASE_URL is not parsed directly
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=agrimind_db

# Google Gemini API Key
# Set your key here or via GEMINI_API_KEY environment variable.
GEMINI_API_KEY=your_gemini_api_key_here
